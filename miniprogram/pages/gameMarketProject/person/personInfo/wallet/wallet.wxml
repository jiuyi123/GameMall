<!--pages/gameMarketProject/person/personInfo/feedback/feedback.wxml-->
<view style="display: flex;flex-direction: column;height: 100%;align-items: center;">
  <view style="height: 30%;width: 100%;border-bottom-left-radius: 30%;border-bottom-right-radius:30% ;background-color: rgb(0, 36, 59);display: flex;flex-direction: column;align-items: center;justify-content: space-between;">
    <!-- 金额 -->
    <view style="display: flex;flex-direction: column;align-items: center;margin-top: 5%; ">
      <text style="color: white;font-size: xx-large;font-weight: bolder;">{{Balance}}</text>
      <text style="color: white;font-weight: bolder;margin-top: 5%;">金额(元)</text>
      <button bindtap="showPopup" size="mini" style="background-color: yellowgreen;color: white;margin-top: 30rpx;">充值</button>
    </view>

    <van-popup closeable show="{{ show }}" position="bottom" bind:close="onClose">
      <text style="color: black;font-size: larger;font-weight: bolder;">请输入充值金额</text>
      <input type="number" bindinput="bindInputChange" style="margin-top: 30rpx;margin-bottom: 30rpx;" />
      <button bindtap="Charge" style="background-color: rgb(255, 44, 29);">确定</button>
    </van-popup>

    <!-- <view style="height: 20%;width: 60%;background-color: rgb(149, 149, 149);"></view> -->
  </view>
  <!-- <view style="height: 7%;width: 60%;background-color: rgb(149, 149, 149);"></view> -->
</view>