<!--pages/gameMarketProject/friend/friendAdd/friendAdd.wxml-->
<view>
  <!-- 搜索框 -->
  <view style="display: flex; flex-direction: row;justify-content: space-around;align-items: center;background: rgb(4, 15, 29,0);">
    <view style="width: 600rpx;">
      <van-search placeholder="{{Search_text}}" shape="round" bind:change='bindAddContent' background="rgb(4, 15, 29,0)">
      </van-search>
    </view>
    <van-button bindtap="Search" color="rgb(0, 196, 190)" size="small" style="align-items: center;margin-right: 20rpx;">搜索</van-button>
  </view>
  <scroll-view scroll-y="true" style="height:{{winHeight}}rpx; margin-left: 20rpx;margin-right: 20rpx;width: 700rpx;">
    <!-- 好友列表 -->
    <view wx:for="{{Search_List}}" data-item="item">
      <!-- 滑动单元格 -->
      <van-swipe-cell custom-style="border: 3rpx solid rgb(130, 206, 31);">
        <!-- 用户头像和昵称 -->
        <view data-user-Info="{{item}}" bindtap="goUserInfo" style="display: flex;flex-direction: row;justify-content: space-between;align-items: center;">
          <view style="display: flex;flex-direction: row;align-items: center;">
            <!-- 用户头像 -->
            <view style="height: 120rpx;">
              <image src="{{item.Photo_link}}" mode="scaleToFill" style="height: 100rpx;width:100rpx; margin: 10rpx;" />
            </view>
            <view>
              <view style="color: white;margin-left: 35rpx;">{{item.Nickname}}</view>
            </view>
          </view>
          <view>
            <button wx:if="{{!item.IsFriend}}" data-user-Info="{{item}}" bindtap="Add_Friend" size="mini" style="background-color: rgba(111, 230, 100);">添加</button>
            <text wx:if="{{item.IsFriend}}" style="color: aliceblue;">已添加</text>
          </view>
        </view>
      </van-swipe-cell>
      <!-- 分割线 -->
      <view class="hr"></view>
    </view>
  </scroll-view>
</view>